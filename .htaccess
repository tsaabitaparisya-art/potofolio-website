# Disable Directory Browsing
Options -Indexes

# Block access to hidden/sensitive files (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to composer files and logs
<FilesMatch "(composer\.(json|lock)|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# HTTP Security Headers (OWASP ZAP Mitigation)
<IfModule mod_headers.c>
    # Anti-Clickjacking (ZAP Medium)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Anti-MIME Sniffing (ZAP Low)
    Header always set X-Content-Type-Options "nosniff"

    # Content Security Policy (ZAP Medium)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';"

    # HTTP Strict Transport Security - HSTS (ZAP Low)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Cross-Origin Opener Policy
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
